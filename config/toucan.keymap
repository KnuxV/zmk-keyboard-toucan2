// Toucan 2: Selenium keymap (HRM flavor) for an Ergo-L host on Linux
//
// 2026-09-10 hybrid: Selenium layers kept, base layer thumbs and home-row mods
// changed to match Kevin's Corne Vial layout.
//   HRM  : Ctrl/Alt/Gui on ring/middle/index (S D F, mirrored L K J). Pinky plain.
//   Left thumbs  (outer->inner): Esc, Shift (hold) / sticky Shift (tap) / Caps Word (2 taps), Nav-Backspace
//   Right thumbs (inner->outer): Nav-Space, Sym-Enter (hold), Fn-Delete
// Hand-port of OneDeadKey/zmk-config-aekeynox using stock ZMK v0.3 behaviors,
// so it drops into beekeeb/zmk-keyboard-toucan2 as config/toucan.keymap
// with no other file changed (trackpad, screen, LEDs, zoom all untouched).

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

// ---------------------------------------------------------------------------
// Layer indices. Order chosen to match what toucan.dtsi hard-codes:
//   is_touching_processor -> &mo 4   (mouse layer)
//   trackpad scroller     -> <1 2>   (hold Sym or Nav + move pad = scroll)
// ---------------------------------------------------------------------------
#define BASE  0
#define SYM   1
#define NAV   2   // Selenium "NavNum"
#define NUML  3   // Selenium "NumLock" (latched NavNum)
#define MOUSE 4
#define FN    5   // Selenium "FnMedia"

// Selenium timings (aekeynox defaults.h)
#define TAPPING_TERM       300
#define SHORT_TAPPING_TERM 150
#define QUICK_TAP          200

// Linux: Ctrl is the shortcut modifier
#define CMD LC

// ---------------------------------------------------------------------------
// Ergo-L host aliases (copied from aekeynox aliases/ergol.h)
// Keycodes are chosen so the Ergo-L xkb layout outputs the right symbol.
// ---------------------------------------------------------------------------
#define X_UNDO  &kp CMD(Z)
#define X_CUT   &kp CMD(X)
#define X_COPY  &kp CMD(W)
#define X_PASTE &kp CMD(V)
#define X_REDO  &kp CMD(P)
#define X_ALL   &kp CMD(A)

// Symbols layer: ^<>$% @&*'`  {()}= \+-/"  ~[]_# |!;:?
#define S_CARET &kp CARET
#define S_LT    &kp NUBS
#define S_GT    &kp PIPE2
#define S_DLLR  &kp DLLR
#define S_PRCNT &kp PRCNT
#define S_AT    &kp RPAR
#define S_AMPS  &kp AMPS
#define S_STAR  &kp STAR
#define S_SQT   &kp SQT
#define S_GRAVE &kp GRAVE
#define S_LBRC  &kp LBRC
#define S_LPAR  &kp RA(S)
#define S_RPAR  &kp RA(D)
#define S_RBRC  &kp RBRC
#define S_EQUAL &kp EQUAL
#define S_BSLH  &kp BSLH
#define S_PLUS  &kp PLUS
#define S_MINUS &kp C
#define S_FSLH  &kp MINUS
#define S_DQT   &kp DQT
#define S_TILDE &kp TILDE
#define S_LBKT  &kp LBKT
#define S_RBKT  &kp RBKT
#define S_UNDER &kp UNDER
#define S_HASH  &kp LPAR
#define S_PIPE  &kp PIPE
#define S_EXCL  &kp RS(O)
#define S_SEMI  &kp LS(DOT)
#define S_COLON &kp LS(N)
#define S_QMARK &kp LS(C)
#define S_COMMA &kp DOT
#define S_DOT   &kp N
#define S_MONEY &kp LS(N1)

// "Easy" sticky layer / sticky key: hold = momentary, tap = one-shot
#define EZ_SL(layer) &bsl layer layer
#define EZ_SK(mod)   &bsk mod mod

// Global tweaks from aekeynox hold_taps.dtsi
&sl { ignore-modifiers; };  // keep one-shot mods when chaining into a one-shot layer
&sk { quick-release; };     // avoids sticky-shift false positives
&mt { tapping-term-ms = <SHORT_TAPPING_TERM>; quick-tap-ms = <QUICK_TAP>; };
&lt { tapping-term-ms = <TAPPING_TERM>;       quick-tap-ms = <QUICK_TAP>; };

/ {
    behaviors {
        // Home-row mods
        hrm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <TAPPING_TERM>;
            quick-tap-ms = <QUICK_TAP>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        // "Space cadet": layer-tap with hold-preferred (thumb keys)
        sc: space_cadet {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <SHORT_TAPPING_TERM>;
            quick-tap-ms = <QUICK_TAP>;
            flavor = "hold-preferred";
            bindings = <&mo>, <&kp>;
        };

        // More robust one-shot layer / one-shot mod (macro-wrapped &sl / &sk)
        osl: one_shot_layer {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            tap-ms = <0>;
            wait-ms = <0>;
            bindings = <&macro_param_1to1>, <&macro_tap &sl MACRO_PLACEHOLDER>;
        };
        bsl: better_sticky_layer {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <TAPPING_TERM>;
            flavor = "tap-preferred";
            bindings = <&mo>, <&osl>;
        };
        osm: one_shot_modifier {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            tap-ms = <0>;
            wait-ms = <0>;
            bindings = <&macro_param_1to1>, <&macro_tap &sk MACRO_PLACEHOLDER>;
        };
        bsk: better_sticky_key {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <TAPPING_TERM>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&osm>;
            hold-while-undecided;
        };

        // Left tuck thumb: sticky Shift, Shift + tap again = Caps Word
        shift_caps: shift_caps {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <EZ_SK(LSHIFT)>, <&unshift_caps>;
            mods = <(MOD_LSFT)>;
        };
        unshift_caps: unshift_caps {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &kp K_CANCEL>, <&caps_word>;
        };

        // Right tuck thumb: one-shot Symbols layer;
        // with Shift only -> one-shot Shift+AltGr (Ergo-L 3rd level shifted)
        sym_shift_altgr: sym_shift_altgr {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&sym_shift_altgr_inner>, <EZ_SL(SYM)>;
            mods = <(MOD_LCTL|MOD_RCTL|MOD_LGUI|MOD_RGUI|MOD_LALT)>;
            keep-mods = <(MOD_LCTL|MOD_RCTL|MOD_LGUI|MOD_RGUI|MOD_LALT)>;
        };
        sym_shift_altgr_inner: sym_shift_altgr_inner {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <EZ_SL(SYM)>, <EZ_SK(LS(RALT))>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
            keep-mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        // NavNum right-outer thumb: tap = back to base + one-shot AltGr, hold = AltGr
        lkp: goto_layer_then_keypress {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings
                = <&macro_tap &to BASE>
                , <&macro_param_1to1>, <&macro_press &kp MACRO_PLACEHOLDER>
                , <&macro_pause_for_release>
                , <&macro_param_1to1>, <&macro_release &kp MACRO_PLACEHOLDER>;
        };
        losm: goto_layer_then_osm {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings
                = <&macro_tap &to BASE>
                , <&macro_param_1to1>, <&macro_tap &sk MACRO_PLACEHOLDER>;
        };
        lbsk: bsk_on_other_layer {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <TAPPING_TERM>;
            flavor = "tap-preferred";
            bindings = <&lkp>, <&losm>;
        };

        // FnMedia: tap = BT profile 1, Shift+tap = clear that profile's bond
        bt_sel1_clr: bt_sel1_clr {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 1>, <&bt BT_CLR>;
            mods = <(MOD_LSFT)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // 0. Base: QWERTY keycodes, host does Ergo-L. HRM: Gui/Ctl/Alt on ring/middle/index
        base {
            display-name = "Base";
            bindings = <
&kp TAB    &kp Q  &kp W          &kp E          &kp R          &kp T     &kp Y  &kp U          &kp I          &kp O          &kp P     &kp BSPC
&kp ESC    &kp A  &hrm LCTRL S   &hrm LALT D    &hrm LGUI F    &kp G     &kp H  &hrm LGUI J    &hrm LALT K    &hrm LCTRL L   &kp SEMI  &kp RET
&kp LSHFT  &kp Z  &kp X          &kp C          &kp V          &kp B     &kp N  &kp M          &kp COMMA      &kp DOT        &kp FSLH  &kp RSHFT
                  &kp ESC        &shift_caps    &sc NAV BSPC             &lt NAV SPACE  &sc SYM RET    &sc FN DEL
            >;
        };

        // 1. Symbols (same as Ergo-L AltGr layer). Trackpad scrolls while held.
        sym {
            display-name = "Symbols";
            bindings = <
&trans  S_CARET S_LT    S_GT    S_DLLR  S_PRCNT     S_AT    S_AMPS  S_STAR  S_SQT   S_GRAVE  &trans
&trans  S_LBRC  S_LPAR  S_RPAR  S_RBRC  S_EQUAL     S_BSLH  S_PLUS  S_MINUS S_FSLH  S_DQT    &trans
&trans  S_TILDE S_LBKT  S_RBKT  S_UNDER S_HASH      S_PIPE  S_EXCL  S_SEMI  S_COLON S_QMARK  &trans
                &trans  &trans  &trans      &trans  &trans  &trans
            >;
        };

        // 2. NavNum: arrows left, numpad right. Trackpad scrolls while held.
        nav {
            display-name = "NavNum";
            bindings = <
&trans  &kp ESC  &kp HOME &kp UP   &kp END   &kp PG_UP    &to NUML  &kp N7 &kp N8 &kp N9 S_FSLH  &trans
&trans  X_ALL    &kp LEFT &kp DOWN &kp RIGHT &kp PG_DN    S_MINUS   &kp N4 &kp N5 &kp N6 &kp N0  &trans
&trans  X_UNDO   X_CUT    X_COPY   X_PASTE   X_REDO       S_COMMA   &kp N1 &kp N2 &kp N3 S_DOT   &trans
                 &trans         &trans      &kp LS(TAB)   &kp ESC   &lt FN LS(SPACE)  &lbsk RALT RALT
            >;
        };

        // 3. NumLock: NavNum latched on, &to BASE (top right index) to leave
        numlock {
            display-name = "NumLock";
            bindings = <
&trans  &kp ESC  &kp HOME &kp UP   &kp END   &kp PG_UP    &to BASE  &kp N7 &kp N8 &kp N9 S_FSLH  &trans
&trans  S_EQUAL  &kp LEFT &kp DOWN &kp RIGHT &kp PG_DN    S_MINUS   &kp N4 &kp N5 &kp N6 &kp N0  &trans
&trans  S_MONEY  S_COLON  S_STAR   S_PLUS    S_PRCNT      S_COMMA   &kp N1 &kp N2 &kp N3 S_DOT   &trans
                 &trans  &trans        &trans             &lt NAV LS(SPACE)  &trans    &trans
            >;
        };

        // 4. Mouse: auto-activated while touching the trackpad (Toucan default)
        mouse {
            display-name = "Mouse";
            bindings = <
&trans &trans &trans &trans &trans &trans    &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans    &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans    &trans &trans &trans &trans &trans &trans
                   &mkp MCLK &mkp LCLK &mkp RCLK    &mkp LCLK &mkp RCLK &mkp MCLK
            >;
        };

        // 5. FnMedia: F-keys left, media + BT right. Reach thumbs (hold) to enter.
        fn {
            display-name = "FnMedia";
            bindings = <
&trans  &kp F1 &kp F2  &kp F3  &kp F4  &none    &bt BT_SEL 2  &kp C_NEXT          &kp C_VOL_UP        &kp C_BRI_UP           &kp SLCK           &trans
&trans  &kp F5 &kp F6  &kp F7  &kp F8  &none    &bt_sel1_clr  &hrm LALT C_PP      &hrm LCTRL C_MUTE   &hrm LGUI C_AL_LOCK    &hrm LSHFT PSCRN   &trans
&trans  &kp F9 &kp F10 &kp F11 &kp F12 &none    &bt BT_SEL 0  &kp C_PREV          &kp C_VOL_DN        &kp C_BRI_DN           &kp INS            &trans
                       &trans  &bootloader  &trans              &studio_unlock  &sys_reset  &trans
            >;
        };
    };
};

// ---------------------------------------------------------------------------
// Optional: Toucan trackpad gestures default to macOS shortcuts (Cmd).
// Keypad -/+ zoom works in Firefox/Chromium regardless of Ergo-L.
// Swipes N/E/S/W: set to your Hyprland binds (~/.config/hypr).
// ---------------------------------------------------------------------------
&zip_zoom_mapper {
    bindings = <&kp LC(KP_MINUS)>, <&kp LC(KP_PLUS)>;
};

&swipe_button_mapper {
    bindings = <&kp LG(TAB)>, <&kp LG(RIGHT)>, <&kp LG(LS(TAB))>, <&kp LG(LEFT)>;
};
